{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "cf-ai",
    "account_id": "7ab77eaa396c9a6435e5659a299e07cf",
    "main": ".cloudflare/output/v0/workers/default/bundle/index.js",
    "assets": {
        "directory": ".cloudflare/output/v0/workers/default/assets",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "none",
        "run_worker_first": true
    },
    "compatibility_date": "2026-10-27",
    "compatibility_flags": ["nodejs_compat"],
    "ai": {
        "binding": "AI"
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "chatbot-db",
            "database_id": "23e4591c-4d67-4851-8e50-772a7b1fc6be"
        }
    ],
    "r2_buckets": [
        {
            "binding": "FILES",
            "bucket_name": "chatbot-files"
        }
    ],
    "vectorize": [
        {
            "binding": "VECTORIZE",
            "index_name": "chatbot-rag-index"
        }
    ],
    "workflows": [
        {
            "name": "pdf-processing-workflow",
            "binding": "PDF_WORKFLOW",
            "class_name": "PdfProcessingWorkflow"
        },
        {
            "name": "youtube-processing-workflow",
            "binding": "YOUTUBE_WORKFLOW",
            "class_name": "YoutubeProcessingWorkflow"
        }
    ],
    "durable_objects": {
        "bindings": [
            {
                "name": "DOCUMENT_PROGRESS_DO",
                "class_name": "DocumentProgressDO"
            }
        ]
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["DocumentProgressDO"]
        }
    ]
}
